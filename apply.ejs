<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Başvuru Yap - Discord Bot Panel</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }
        h1 {
            color: #5865F2;
            margin-bottom: 10px;
            font-size: 32px;
        }
        .subtitle {
            color: #666;
            margin-bottom: 30px;
        }
        .form-group {
            margin-bottom: 25px;
        }
        label {
            display: block;
            color: #333;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 14px;
        }
        input, textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.3s;
            font-family: inherit;
        }
        input:focus, textarea:focus {
            outline: none;
            border-color: #5865F2;
        }
        textarea {
            resize: vertical;
            min-height: 120px;
        }
        .btn {
            width: 100%;
            padding: 15px;
            background: #5865F2;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn:hover {
            background: #4752C4;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(88, 101, 242, 0.3);
        }
        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            color: #5865F2;
            text-decoration: none;
            font-weight: 600;
        }
        .back-btn:hover {
            text-decoration: underline;
        }
        .alert {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
        }
        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/dashboard" class="back-btn">← Dashboard'a Dön</a>
        
        <h1>🎯 Başvuru Formu</h1>
        <p class="subtitle">Topluluğumuza katılmak için formu doldurun</p>

        <div id="alert" class="alert"></div>

        <form id="applicationForm">
            <div class="form-group">
                <label for="age">Yaşınız *</label>
                <input type="number" id="age" name="age" required min="13" max="99">
            </div>

            <div class="form-group">
                <label for="reason">Neden katılmak istiyorsunuz? *</label>
                <textarea id="reason" name="reason" required placeholder="Topluluğumuza neden katılmak istediğinizi açıklayın..."></textarea>
            </div>

            <div class="form-group">
                <label for="experience">Discord deneyiminiz</label>
                <textarea id="experience" name="experience" placeholder="Discord'u ne kadar süredir kullanıyorsunuz? Moderasyon deneyiminiz var mı?"></textarea>
            </div>

            <button type="submit" class="btn">📤 Başvuruyu Gönder</button>
        </form>
    </div>

    <script>
        document.getElementById('applicationForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = {
                age: document.getElementById('age').value,
                reason: document.getElementById('reason').value,
                experience: document.getElementById('experience').value
            };

            try {
                const response = await fetch('/api/apply', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();
                
                const alert = document.getElementById('alert');
                alert.style.display = 'block';
                
                if (data.success) {
                    alert.className = 'alert alert-success';
                    alert.textContent = '✅ ' + data.message;
                    setTimeout(() => {
                        window.location.href = '/my-application';
                    }, 2000);
                } else {
                    alert.className = 'alert alert-error';
                    alert.textContent = '❌ ' + data.message;
                }
            } catch (error) {
                const alert = document.getElementById('alert');
                alert.style.display = 'block';
                alert.className = 'alert alert-error';
                alert.textContent = '❌ Bir hata oluştu!';
            }
        });
    </script>
</body>
</html>
