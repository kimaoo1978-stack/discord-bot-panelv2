<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Başvurular - Discord Bot Panel</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }
        h1 {
            color: #5865F2;
            margin-bottom: 10px;
        }
        .subtitle {
            color: #666;
            margin-bottom: 30px;
        }
        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            color: #5865F2;
            text-decoration: none;
            font-weight: 600;
        }
        .back-btn:hover {
            text-decoration: underline;
        }
        
        .header-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }
        .btn {
            padding: 12px 24px;
            background: #5865F2;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s;
            display: inline-block;
        }
        .btn:hover {
            background: #4752C4;
            transform: translateY(-2px);
        }
        
        .filters {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }
        .filter-btn {
            padding: 10px 20px;
            border: 2px solid #e0e0e0;
            background: white;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }
        .filter-btn.active {
            background: #5865F2;
            color: white;
            border-color: #5865F2;
        }
        .filter-btn:hover {
            border-color: #5865F2;
        }
        
        .applications-grid {
            display: grid;
            gap: 20px;
        }
        .app-card {
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            padding: 25px;
            transition: all 0.3s;
            background: white;
        }
        .app-card:hover {
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            border-color: #5865F2;
        }
        
        .app-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 15px;
        }
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: 3px solid #5865F2;
        }
        .user-details h3 {
            color: #333;
            margin-bottom: 5px;
        }
        .user-details p {
            color: #666;
            font-size: 14px;
        }
        
        .status-badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }
        .badge-pending {
            background: #fff3cd;
            color: #856404;
        }
        .badge-approved {
            background: #d4edda;
            color: #155724;
        }
        .badge-rejected {
            background: #f8d7da;
            color: #721c24;
        }
        
        .app-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }
        .detail-box {
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 3px solid #5865F2;
        }
        .detail-label {
            font-size: 12px;
            color: #666;
            margin-bottom: 5px;
            text-transform: uppercase;
            font-weight: 600;
        }
        .detail-value {
            color: #333;
            font-weight: 600;
            font-size: 16px;
        }
        
        .app-content {
            margin-top: 20px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
        }
        .app-content h4 {
            color: #5865F2;
            margin-bottom: 10px;
        }
        .app-content p {
            color: #333;
            line-height: 1.6;
        }
        
        .no-applications {
            text-align: center;
            padding: 80px 20px;
        }
        .no-applications h2 {
            color: #666;
            margin-bottom: 15px;
        }
        .no-applications p {
            color: #999;
            margin-bottom: 30px;
        }
        
        .stats-bar {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }
        .stat-item {
            flex: 1;
            min-width: 150px;
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 10px;
            color: white;
            text-align: center;
        }
        .stat-number {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 5px;
        }
        .stat-label {
            font-size: 14px;
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/dashboard" class="back-btn">← Dashboard'a Dön</a>
        
        <div class="header-actions">
            <div>
                <h1>📋 Başvurular</h1>
                <p class="subtitle">Tüm başvuruları görüntüleyin ve yönetin</p>
            </div>
            <a href="/apply" class="btn">+ Yeni Başvuru Yap</a>
        </div>

        <!-- İstatistikler -->
        <div class="stats-bar">
            <div class="stat-item">
                <div class="stat-number" id="totalCount">0</div>
                <div class="stat-label">Toplam</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" id="pendingCount">0</div>
                <div class="stat-label">Bekleyen</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" id="approvedCount">0</div>
                <div class="stat-label">Onaylanan</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" id="rejectedCount">0</div>
                <div class="stat-label">Reddedilen</div>
            </div>
        </div>

        <!-- Filtreler -->
        <div class="filters">
            <button class="filter-btn active" onclick="filterApps('all')">🔍 Tümü</button>
            <button class="filter-btn" onclick="filterApps('pending')">⏳ Bekleyen</button>
            <button class="filter-btn" onclick="filterApps('approved')">✅ Onaylanan</button>
            <button class="filter-btn" onclick="filterApps('rejected')">❌ Reddedilen</button>
        </div>

        <!-- Başvuru Listesi -->
        <div class="applications-grid" id="appsList">
            <% if (applications && applications.length > 0) { %>
                <% applications.forEach(app => { %>
                    <div class="app-card" data-status="<%= app.status %>">
                        <div class="app-header">
                            <div class="user-info">
                                <img src="https://cdn.discordapp.com/avatars/<%= app.userId %>/<%= app.avatar %>.png" 
                                     class="avatar" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                                <div class="user-details">
                                    <h3><%= app.username %></h3>
                                    <p><%= app.discordTag %></p>
                                </div>
                            </div>
                            <span class="status-badge badge-<%= app.status %>">
                                <% if (app.status === 'pending') { %>
                                    ⏳ Beklemede
                                <% } else if (app.status === 'approved') { %>
                                    ✅ Onaylandı
                                <% } else { %>
                                    ❌ Reddedildi
                                <% } %>
                            </span>
                        </div>

                        <div class="app-details">
                            <div class="detail-box">
                                <div class="detail-label">Başvuru Tarihi</div>
                                <div class="detail-value"><%= new Date(app.createdAt).toLocaleDateString('tr-TR') %></div>
                            </div>
                            <div class="detail-box">
                                <div class="detail-label">Yaş</div>
                                <div class="detail-value"><%= app.age %></div>
                            </div>
                            <% if (app.email) { %>
                            <div class="detail-box">
                                <div class="detail-label">E-posta</div>
                                <div class="detail-value" style="font-size: 13px;"><%= app.email %></div>
                            </div>
                            <% } %>
                        </div>

                        <div class="app-content">
                            <h4>💬 Katılma Sebebi:</h4>
                            <p><%= app.reason %></p>
                        </div>

                        <% if (app.experience) { %>
                        <div class="app-content" style="margin-top: 15px;">
                            <h4>⭐ Deneyim:</h4>
                            <p><%= app.experience %></p>
                        </div>
                        <% } %>

                        <% if (app.reviewedBy) { %>
                        <div class="app-content" style="margin-top: 15px; background: #e3f2fd;">
                            <h4>👤 İnceleyen: <%= app.reviewedBy %></h4>
                            <p><strong>Tarih:</strong> <%= new Date(app.reviewedAt).toLocaleDateString('tr-TR') %></p>
                            <% if (app.reviewNote) { %>
                                <p><strong>Not:</strong> <%= app.reviewNote %></p>
                            <% } %>
                        </div>
                        <% } %>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="no-applications">
                    <h2>📭 Henüz başvuru yok</h2>
                    <p>İlk başvuruyu yapmak için aşağıdaki butona tıklayın</p>
                    <a href="/apply" class="btn">🎯 İlk Başvuruyu Yap</a>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        // İstatistikleri güncelle
        function updateStats() {
            const cards = document.querySelectorAll('.app-card');
            let total = cards.length;
            let pending = 0;
            let approved = 0;
            let rejected = 0;

            cards.forEach(card => {
                const status = card.dataset.status;
                if (status === 'pending') pending++;
                if (status === 'approved') approved++;
                if (status === 'rejected') rejected++;
            });

            document.getElementById('totalCount').textContent = total;
            document.getElementById('pendingCount').textContent = pending;
            document.getElementById('approvedCount').textContent = approved;
            document.getElementById('rejectedCount').textContent = rejected;
        }

        // Filtreleme
        function filterApps(status) {
            const cards = document.querySelectorAll('.app-card');
            const buttons = document.querySelectorAll('.filter-btn');
            
            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            
            cards.forEach(card => {
                if (status === 'all' || card.dataset.status === status) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Sayfa yüklendiğinde istatistikleri güncelle
        updateStats();
    </script>
</body>
</html>
