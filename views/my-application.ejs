<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Başvurum - Discord Bot Panel</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }
        h1 {
            color: #5865F2;
            margin-bottom: 10px;
        }
        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            color: #5865F2;
            text-decoration: none;
            font-weight: 600;
        }
        .back-btn:hover {
            text-decoration: underline;
        }
        .no-application {
            text-align: center;
            padding: 60px 20px;
            background: #f8f9fa;
            border-radius: 12px;
            margin-top: 30px;
        }
        .no-application h2 {
            color: #333;
            margin-bottom: 15px;
        }
        .no-application p {
            color: #666;
            margin-bottom: 25px;
        }
        .btn {
            display: inline-block;
            padding: 12px 30px;
            background: #5865F2;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s;
        }
        .btn:hover {
            background: #4752C4;
            transform: translateY(-2px);
        }
        .status-badge {
            display: inline-block;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 20px;
        }
        .status-pending {
            background: #fff3cd;
            color: #856404;
        }
        .status-approved {
            background: #d4edda;
            color: #155724;
        }
        .status-rejected {
            background: #f8d7da;
            color: #721c24;
        }
        .application-details {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 30px;
            margin-top: 30px;
        }
        .detail-row {
            display: flex;
            padding: 15px 0;
            border-bottom: 1px solid #e0e0e0;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            font-weight: 600;
            color: #666;
            width: 200px;
        }
        .detail-value {
            color: #333;
            flex: 1;
        }
        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: #333;
            margin: 30px 0 15px 0;
            padding-bottom: 10px;
            border-bottom: 2px solid #5865F2;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/dashboard" class="back-btn">← Dashboard'a Dön</a>
        
        <h1>📋 Başvurum</h1>
        <p style="color: #666; margin-bottom: 20px;">Başvuru durumunuzu ve detaylarınızı görüntüleyin</p>

        <% if (application) { %>
            <div style="text-align: center; margin: 30px 0;">
                <% if (application.status === 'pending') { %>
                    <span class="status-badge status-pending">⏳ İnceleniyor</span>
                <% } else if (application.status === 'approved') { %>
                    <span class="status-badge status-approved">✅ Onaylandı</span>
                <% } else if (application.status === 'rejected') { %>
                    <span class="status-badge status-rejected">❌ Reddedildi</span>
                <% } %>
            </div>

            <div class="application-details">
                <div class="section-title">👤 Kişisel Bilgiler</div>
                
                <div class="detail-row">
                    <div class="detail-label">Discord Kullanıcı Adı:</div>
                    <div class="detail-value"><%= application.username %></div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Yaş:</div>
                    <div class="detail-value"><%= application.age %></div>
                </div>

                <div class="section-title">💼 Başvuru Bilgileri</div>
                
                <div class="detail-row">
                    <div class="detail-label">Başvuru Pozisyonu:</div>
                    <div class="detail-value"><%= application.position %></div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Deneyim:</div>
                    <div class="detail-value"><%= application.experience %></div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Neden Katılmak İstiyorsunuz?</div>
                    <div class="detail-value"><%= application.reason %></div>
                </div>

                <div class="section-title">📅 Tarih Bilgileri</div>
                
                <div class="detail-row">
                    <div class="detail-label">Başvuru Tarihi:</div>
                    <div class="detail-value"><%= new Date(application.createdAt).toLocaleDateString('tr-TR') %></div>
                </div>
                
                <% if (application.reviewedAt) { %>
                <div class="detail-row">
                    <div class="detail-label">İnceleme Tarihi:</div>
                    <div class="detail-value"><%= new Date(application.reviewedAt).toLocaleDateString('tr-TR') %></div>
                </div>
                <% } %>

                <% if (application.adminNote) { %>
                <div class="section-title">📝 Admin Notu</div>
                <div style="background: white; padding: 15px; border-radius: 8px; margin-top: 15px;">
                    <%= application.adminNote %>
                </div>
                <% } %>
            </div>

        <% } else { %>
            <div class="no-application">
                <h2>😊 Henüz Başvuru Yapmadınız</h2>
                <p>Ekibimize katılmak için hemen başvuru yapabilirsiniz!</p>
                <a href="/apply" class="btn">📝 Başvuru Yap</a>
            </div>
        <% } %>
    </div>
</body>
</html>
