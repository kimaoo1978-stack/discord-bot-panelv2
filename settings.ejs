<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ayarlar - Discord Bot Panel</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }
        h1 {
            color: #5865F2;
            margin-bottom: 10px;
        }
        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            color: #5865F2;
            text-decoration: none;
            font-weight: 600;
        }
        .back-btn:hover {
            text-decoration: underline;
        }
        
        .profile-section {
            display: flex;
            align-items: center;
            gap: 30px;
            padding: 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 12px;
            margin-bottom: 30px;
            color: white;
        }
        .profile-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 4px solid white;
        }
        .profile-info h2 {
            margin-bottom: 5px;
        }
        .profile-info p {
            opacity: 0.9;
            font-size: 14px;
        }
        
        .settings-section {
            margin-bottom: 30px;
        }
        .section-title {
            font-size: 20px;
            font-weight: 600;
            color: #333;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #f0f0f0;
        }
        
        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
            margin-bottom: 15px;
        }
        .setting-info h4 {
            color: #333;
            margin-bottom: 5px;
        }
        .setting-info p {
            color: #666;
            font-size: 14px;
        }
        
        .toggle-switch {
            position: relative;
            width: 60px;
            height: 30px;
        }
        .toggle-switch input {
            display: none;
        }
        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: 0.4s;
            border-radius: 30px;
        }
        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 22px;
            width: 22px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: 0.4s;
            border-radius: 50%;
        }
        input:checked + .toggle-slider {
            background-color: #5865F2;
        }
        input:checked + .toggle-slider:before {
            transform: translateX(30px);
        }
        
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .info-card {
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
            border-left: 4px solid #5865F2;
        }
        .info-card h4 {
            color: #666;
            font-size: 14px;
            margin-bottom: 8px;
        }
        .info-card p {
            color: #333;
            font-size: 18px;
            font-weight: 600;
        }
        
        .btn {
            padding: 12px 30px;
            background: #5865F2;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn:hover {
            background: #4752C4;
            transform: translateY(-2px);
        }
        .btn-danger {
            background: #ed4245;
        }
        .btn-danger:hover {
            background: #c03537;
        }
        
        .alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
        }
        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/dashboard" class="back-btn">← Dashboard'a Dön</a>
        
        <h1>⚙️ Ayarlar</h1>
        <p style="color: #666; margin-bottom: 30px;">Profil ve bildirim ayarlarınızı yönetin</p>

        <div id="alert" class="alert alert-success"></div>

        <!-- Profil Bilgileri -->
        <div class="profile-section">
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" 
                 class="profile-avatar" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
            <div class="profile-info">
                <h2><%= user.username %></h2>
                <p>📧 <%= user.email || 'E-posta belirtilmemiş' %></p>
                <p>🆔 User ID: <%= user.id %></p>
            </div>
        </div>

        <!-- Hesap Bilgileri -->
        <div class="settings-section">
            <div class="section-title">📊 Hesap Bilgileri</div>
            <div class="info-grid">
                <div class="info-card">
                    <h4>Toplam Sunucu</h4>
                    <p><%= user.guilds ? user.guilds.length : 0 %></p>
                </div>
                <div class="info-card">
                    <h4>Hesap Durumu</h4>
                    <p>✅ Aktif</p>
                </div>
                <div class="info-card">
                    <h4>Üyelik Tipi</h4>
                    <p>🌟 Standart</p>
                </div>
            </div>
        </div>

        <!-- Bildirim Ayarları -->
        <div class="settings-section">
            <div class="section-title">🔔 Bildirim Ayarları</div>
            
            <div class="setting-item">
                <div class="setting-info">
                    <h4>Başvuru Bildirimleri</h4>
                    <p>Başvurunuzla ilgili güncellemeleri alın</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked id="appNotif">
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h4>Aktivite Raporları</h4>
                    <p>Haftalık aktivite raporlarını e-posta ile alın</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" id="activityNotif">
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h4>Sistem Bildirimleri</h4>
                    <p>Sistem güncellemeleri ve duyuruları</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked id="systemNotif">
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </div>

        <!-- Gizlilik Ayarları -->
        <div class="settings-section">
            <div class="section-title">🔒 Gizlilik Ayarları</div>
            
            <div class="setting-item">
                <div class="setting-info">
                    <h4>Profil Görünürlüğü</h4>
                    <p>Diğer üyelerin profilinizi görmesine izin verin</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked id="profileVisible">
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h4>Aktivite Görünürlüğü</h4>
                    <p>İstatistiklerde görünün</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked id="activityVisible">
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </div>

        <!-- Aksiyon Butonları -->
        <div class="settings-section">
            <div class="section-title">⚡ Hızlı İşlemler</div>
            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                <button class="btn" onclick="saveSettings()">💾 Ayarları Kaydet</button>
                <button class="btn btn-danger" onclick="clearCache()">🗑️ Önbelleği Temizle</button>
            </div>
        </div>
    </div>

    <script>
        function saveSettings() {
            const alert = document.getElementById('alert');
            alert.textContent = '✅ Ayarlarınız başarıyla kaydedildi!';
            alert.style.display = 'block';
            
            setTimeout(() => {
