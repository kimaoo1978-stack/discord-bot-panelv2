<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ayarlar - Discord Bot Panel</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
        }
        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            color: white;
            text-decoration: none;
            font-weight: 600;
            padding: 10px 20px;
            background: rgba(255,255,255,0.2);
            border-radius: 8px;
            transition: all 0.3s;
        }
        .back-btn:hover {
            background: rgba(255,255,255,0.3);
        }
        
        .header {
            background: white;
            border-radius: 15px;
            padding: 40px;
            margin-bottom: 25px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }
        h1 {
            color: #5865F2;
            margin-bottom: 10px;
            font-size: 36px;
        }
        .subtitle {
            color: #666;
            font-size: 16px;
        }
        
        .profile-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 30px;
        }
        .profile-avatar-large {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 5px solid #5865F2;
            box-shadow: 0 5px 20px rgba(88, 101, 242, 0.3);
        }
        .profile-details {
            flex: 1;
        }
        .profile-details h2 {
            color: #333;
            margin-bottom: 10px;
            font-size: 28px;
        }
        .profile-meta {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 15px;
        }
        .meta-item {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #666;
            font-size: 14px;
        }
        .meta-icon {
            font-size: 18px;
        }
        
        .settings-grid {
            display: grid;
            gap: 25px;
        }
        .settings-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }
        .card-title {
            font-size: 22px;
            font-weight: 600;
            color: #333;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .card-icon {
            font-size: 28px;
        }
        
        .info-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }
        .stat-box {
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 12px;
            color: white;
            text-align: center;
            transition: all 0.3s;
        }
        .stat-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }
        .stat-number {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 5px;
        }
        .stat-label {
            font-size: 13px;
            opacity: 0.9;
        }
        
        .setting-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
            margin-bottom: 15px;
            transition: all 0.3s;
        }
        .setting-row:hover {
            background: #e9ecef;
            transform: translateX(5px);
        }
        .setting-info h4 {
            color: #333;
            margin-bottom: 5px;
            font-size: 16px;
        }
        .setting-info p {
            color: #666;
            font-size: 14px;
        }
        
        .toggle-switch {
            position: relative;
            width: 60px;
            height: 30px;
        }
        .toggle-switch input {
            display: none;
        }
        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: 0.4s;
            border-radius: 30px;
        }
        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 22px;
            width: 22px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: 0.4s;
            border-radius: 50%;
        }
        input:checked + .toggle-slider {
            background-color: #5865F2;
        }
        input:checked + .toggle-slider:before {
            transform: translateX(30px);
        }
        
        .action-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }
        .btn {
            padding: 15px 30px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .btn-primary {
            background: #5865F2;
            color: white;
        }
        .btn-primary:hover {
            background: #4752C4;
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(88, 101, 242, 0.4);
        }
        .btn-danger {
            background: #ed4245;
            color: white;
        }
        .btn-danger:hover {
            background: #c03537;
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(237, 66, 69, 0.4);
        }
        .btn-secondary {
            background: #6c757d;
            color: white;
        }
        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }
        
        .alert {
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: none;
            animation: slideIn 0.3s;
        }
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .alert-success {
            background: #d4edda;
            color: #155724;
            border-left: 4px solid #28a745;
        }
        
        .danger-zone {
            border: 2px solid #ed4245;
            border-radius: 10px;
            padding: 25px;
            margin-top: 20px;
        }
        .danger-zone h4 {
            color: #ed4245;
            margin-bottom: 10px;
            font-size: 18px;
        }
        .danger-zone p {
            color: #666;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/dashboard" class="back-btn">← Dashboard'a Dön</a>
        
        <div class="header">
            <h1>⚙️ Ayarlar</h1>
            <p class="subtitle">Hesap bilgilerinizi ve tercihlerinizi yönetin</p>
        </div>

        <div id="alert" class="alert alert-success"></div>

        <!-- Profil Kartı -->
        <div class="profile-card">
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" 
                 class="profile-avatar-large" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
            <div class="profile-details">
                <h2><%= user.username %></h2>
                <div class="profile-meta">
                    <div class="meta-item">
                        <span class="meta-icon">📧</span>
                        <span><%= user.email || 'E-posta belirtilmemiş' %></span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-icon">🆔</span>
                        <span><%= user.id %></span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-icon">✅</span>
                        <span>Hesap Aktif</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hesap İstatistikleri -->
        <div class="settings-card">
            <div class="card-title">
                <span class="card-icon">📊</span>
                Hesap İstatistikleri
            </div>
            <div class="info-stats">
                <div class="stat-box">
                    <div class="stat-number"><%= user.guilds ? user.guilds.length : 0 %></div>
                    <div class="stat-label">Sunucu Sayısı</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number">Premium</div>
                    <div class="stat-label">Üyelik Tipi</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number">100%</div>
                    <div class="stat-label">Profil Tamamlama</div>
                </div>
            </div>
        </div>

        <!-- Bildirim Ayarları -->
        <div class="settings-card">
            <div class="card-title">
                <span class="card-icon">🔔</span>
                Bildirim Tercihleri
            </div>
            
            <div class="setting-row">
                <div class="setting-info">
                    <h4>📬 Başvuru Bildirimleri</h4>
                    <p>Başvuru durumunuz değiştiğinde e-posta bildirimi alın</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked id="appNotif">
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <h4>📈 Aktivite Raporları</h4>
                    <p>Haftalık aktivite özeti raporlarını e-posta ile alın</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" id="activityNotif">
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <h4>🔔 Sistem Bildirimleri</h4>
                    <p>Önemli sistem güncellemeleri ve duyurular</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked id="systemNotif">
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <h4>🎉 Etkinlik Bildirimleri</h4>
                    <p>Sunucu etkinlikleri ve özel duyurular</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked id="eventNotif">
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </div>

        <!-- Gizlilik Ayarları -->
        <div class="settings-card">
            <div class="card-title">
                <span class="card-icon">🔒</span>
                Gizlilik ve Güvenlik
            </div>
            
            <div class="setting-row">
                <div class="setting-info">
                    <h4>👁️ Profil Görünürlüğü</h4>
                    <p>Diğer kullanıcıların profilinizi görüntülemesine izin ver</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked id="profileVisible">
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <h4>📊 Aktivite Paylaşımı</h4>
                    <p>Aktivite istatistiklerinizin herkese açık görünmesini sağlar</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked id="activityVisible">
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <h4>🔐 İki Faktörlü Doğrulama</h4>
                    <p>Hesabınıza ekstra güvenlik katmanı ekleyin</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" id="twoFactor">
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </div>

        <!-- Hızlı İşlemler -->
        <div class="settings-card">
            <div class="card-title">
                <span class="card-icon">⚡</span>
                Hızlı İşlemler
            </div>
            
            <div class="action-buttons">
                <button class="btn btn-primary" onclick="saveSettings()">
                    <span>💾</span>
                    <span>Tüm Ayarları Kaydet</span>
                </button>
                <button class="btn btn-secondary" onclick="exportData()">
                    <span>📦</span>
                    <span>Verilerimi İndir</span>
                </button>
                <button class="btn btn-secondary" onclick="clearCache()">
                    <span>🗑️</span>
                    <span>Önbelleği Temizle</span>
                </button>
            </div>

            <!-- Tehlikeli Bölge -->
            <div class="danger-zone">
                <h4>⚠️ Tehlikeli Bölge</h4>
                <p>Bu işlemler geri alınamaz. Dikkatli olun!</p>
                <button class="btn btn-danger" onclick="deleteAccount()">
                    <span>🗑️</span>
                    <span>Hesabı Sil</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        function saveSettings() {
            const alert = document.getElementById('alert');
            alert.textContent = '✅ Tüm ayarlarınız başarıyla kaydedildi!';
            alert.style.display = 'block';
            
            setTimeout(() => {
                alert.style.display = 'none';
            }, 3000);
        }

        function exportData() {
            const alert = document.getElementById('alert');
            alert.textContent = '📦 Verileriniz indiriliyor...';
            alert.style.display = 'block';
            
            setTimeout(() => {
                alert.textContent = '✅ Verileriniz başarıyla indirildi!';
                setTimeout(() => {
                    alert.style.display = 'none';
                }, 2000);
            }, 1500);
        }

        function clearCache() {
            if (confirm('Önbelleği temizlemek istediğinizden emin misiniz?')) {
                const alert = document.getElementById('alert');
                alert.textContent = '✅ Önbellek başarıyla temizlendi!';
                alert.style.display = 'block';
                
                setTimeout(() => {
                    alert.style.display = 'none';
                }, 3000);
            }
        }

        function deleteAccount() {
            if (confirm('⚠️ DİKKAT! Hesabınızı silmek istediğinizden EMİN MİSİNİZ? Bu işlem geri alınamaz!')) {
                if (confirm('Son kez soruyoruz: Hesabınızı kalıcı olarak silmek istiyor musunuz?')) {
                    alert('Hesap silme işlemi admin onayı gerektirir. Lütfen yöneticilerle iletişime geçin.');
                }
            }
        }
    </script>
</body>
</html>
