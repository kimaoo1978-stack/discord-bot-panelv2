<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Başvurular</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }
        h1 {
            color: #5865F2;
            margin-bottom: 10px;
        }
        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            color: #5865F2;
            text-decoration: none;
            font-weight: 600;
        }
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }
        .stat-card {
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }
        .stat-card h3 {
            font-size: 32px;
            margin-bottom: 5px;
        }
        .stat-card p {
            color: #666;
            font-size: 14px;
        }
        .stat-total { background: #e3f2fd; color: #1565c0; }
        .stat-pending { background: #fff3cd; color: #856404; }
        .stat-approved { background: #d4edda; color: #155724; }
        .stat-rejected { background: #f8d7da; color: #721c24; }
        
        .filters {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }
        .filter-btn {
            padding: 10px 20px;
            border: 2px solid #e0e0e0;
            background: white;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }
        .filter-btn.active {
            background: #5865F2;
            color: white;
            border-color: #5865F2;
        }
        
        .application-card {
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 15px;
            transition: all 0.3s;
        }
        .application-card:hover {
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .app-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #5865F2;
        }
        .status-badge {
            padding: 6px 15px;
            border-radius: 15px;
            font-size: 12px;
            font-weight: 600;
        }
        .badge-pending { background: #fff3cd; color: #856404; }
        .badge-approved { background: #d4edda; color: #155724; }
        .badge-rejected { background: #f8d7da; color: #721c24; }
        
        .app-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin: 15px 0;
        }
        .detail-item {
            padding: 10px;
            background: #f8f9fa;
            border-radius: 8px;
        }
        .detail-label {
            font-size: 12px;
            color: #666;
            margin-bottom: 5px;
        }
        .detail-value {
            font-weight: 600;
            color: #333;
        }
        
        .actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn-approve {
            background: #28a745;
            color: white;
        }
        .btn-approve:hover {
            background: #218838;
        }
        .btn-reject {
            background: #dc3545;
            color: white;
        }
        .btn-reject:hover {
            background: #c82333;
        }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000;
        }
        .modal-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 30px;
            border-radius: 15px;
            max-width: 500px;
            width: 90%;
        }
        .modal h2 {
            margin-bottom: 20px;
            color: #5865F2;
        }
        textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            resize: vertical;
            min-height: 100px;
            font-family: inherit;
        }
        .modal-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        .btn-cancel {
            background: #6c757d;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/dashboard" class="back-btn">← Dashboard'a Dön</a>
        
        <h1>👥 Başvuru Yönetimi</h1>

        <div class="stats">
            <div class="stat-card stat-total">
                <h3><%= stats.toplamBasvuru %></h3>
                <p>Toplam Başvuru</p>
            </div>
            <div class="stat-card stat-pending">
                <h3><%= stats.bekleyen %></h3>
                <p>Bekleyen</p>
            </div>
            <div class="stat-card stat-approved">
                <h3><%= stats.kabul %></h3>
                <p>Onaylanan</p>
            </div>
            <div class="stat-card stat-rejected">
                <h3><%= stats.red %></h3>
                <p>Reddedilen</p>
            </div>
        </div>

        <div class="filters">
            <button class="filter-btn active" onclick="filterApplications('all')">Tümü</button>
            <button class="filter-btn" onclick="filterApplications('pending')">Bekleyen</button>
            <button class="filter-btn" onclick="filterApplications('approved')">Onaylanan</button>
            <button class="filter-btn" onclick="filterApplications('rejected')">Reddedilen</button>
        </div>

        <div id="applicationsList">
            <% applications.forEach(app => { %>
                <div class="application-card" data-status="<%= app.status %>">
                    <div class="app-header">
                        <div class="user-info">
                            <img src="https://cdn.discordapp.com/avatars/<%= app.userId %>/<%= app.avatar %>.png" 
                                 class="avatar" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                            <div>
                                <h3><%= app.username %></h3>
                                <p style="color: #666; font-size: 14px;"><%= app.discordTag %></p>
                            </div>
                        </div>
                        <span class="status-badge badge-<%= app.status %>">
                            <% if (app.status === 'pending') { %>⏳ Beklemede
                            <% } else if (app.status === 'approved') { %>✅ Onaylandı
                            <% } else { %>❌ Reddedildi<% } %>
                        </span>
                    </div>

                    <div class="app-details">
                        <div class="detail-item">
                            <div class="detail-label">Başvuru Tarihi</div>
                            <div class="detail-value"><%= new Date(app.createdAt).toLocaleDateString('tr-TR') %></div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Yaş</div>
                            <div class="detail-value"><%= app.age %></div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">E-posta</div>
                            <div class="detail-value"><%= app.email || 'Belirtilmemiş' %></div>
                        </div>
                    </div>

                    <div class="detail-item" style="margin-top: 15px;">
                        <div class="detail-label">Katılma Sebebi</div>
                        <div class="detail-value"><%= app.reason %></div>
                    </div>

                    <% if (app.experience) { %>
                    <div class="detail-item" style="margin-top: 15px;">
                        <div class="detail-label">Deneyim</div>
                        <div class="detail-value"><%= app.experience %></div>
                    </div>
                    <% } %>

                    <% if (app.status === 'pending') { %>
                    <div class="actions">
                        <button class="btn btn-approve" onclick="openModal('<%= app._id %>', 'approve')">
                            ✅ Onayla
                        </button>
                        <button class="btn btn-reject" onclick="openModal('<%= app._id %>', 'reject')">
                            ❌ Reddet
                        </button>
                    </div>
                    <% } else { %>
                        <div style="margin-top: 15px; padding: 15px; background: #f8f9fa; border-radius: 8px;">
                            <strong>İnceleyen:</strong> <%= app.reviewedBy %><br>
                            <strong>Tarih:</strong> <%= new Date(app.reviewedAt).toLocaleDateString('tr-TR') %><br>
                            <% if (app.reviewNote) { %>
                                <strong>Not:</strong> <%= app.reviewNote %>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Modal -->
    <div id="modal" class="modal">
        <div class="modal-content">
            <h2 id="modalTitle"></h2>
            <textarea id="reviewNote" placeholder="Yönetici notu (opsiyonel)"></textarea>
            <div class="modal-actions">
                <button class="btn btn-cancel" onclick="closeModal()">İptal</button>
                <button class="btn" id="confirmBtn" onclick="submitReview()">Onayla</button>
            </div>
        </div>
    </div>

    <script>
        let currentAppId = null;
        let currentAction = null;

        function filterApplications(status) {
            const cards = document.querySelectorAll('.application-card');
            const buttons = document.querySelectorAll('.filter-btn');
            
            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            
            cards.forEach(card => {
                if (status === 'all' || card.dataset.status === status) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function openModal(appId, action) {
            currentAppId = appId;
            currentAction = action;
            
            const modal = document.getElementById('modal');
            const title = document.getElementById('modalTitle');
            const confirmBtn = document.getElementById('confirmBtn');
            
            if (action === 'approve') {
                title.textContent = '✅ Başvuruyu Onayla';
                confirmBtn.textContent = 'Onayla';
                confirmBtn.className = 'btn btn-approve';
            } else {
                title.textContent = '❌ Başvuruyu Reddet';
                confirmBtn.textContent = 'Reddet';
                confirmBtn.className = 'btn btn-reject';
            }
            
            modal.style.display = 'block';
        }

        function closeModal() {
            document.getElementById('modal').style.display = 'none';
            document.getElementById('reviewNote').value = '';
        }

        async function submitReview() {
            const note = document.getElementById('reviewNote').value;
            
            try {
                const response = await fetch(`/api/admin/application/${currentAppId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        action: currentAction,
                        note: note
                    })
                });

                const data = await response.json();
                
                if (data.success) {
                    alert('✅ ' + data.message);
                    location.reload();
                } else {
                    alert('❌ ' + data.message);
                }
            } catch (error) {
                alert('❌ Bir hata oluştu!');
            }
            
            closeModal();
        }

        // Modal dışına tıklayınca kapat
        window.onclick = function(event) {
            const modal = document.getElementById('modal');
            if (event.target === modal) {
                closeModal();
            }
        }
    </script>
</body>
</html>
